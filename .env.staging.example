# =============================================================================
# Staging host environment file
# =============================================================================
# Copy to the deploy host:
#   /home/ayush/services/sap-platform/.env.staging
#
# Used by: docker stack deploy (sourced in GitHub Actions deploy workflow)
# Compose file: docker-compose.staging.yml
# UI: http://192.168.0.5:8083
#
# Deploy workflow validates these REQUIRED vars (non-empty):
#   DB_CONNECTION, SAP_SERVICE_LAYER_URL, SAP_USERNAME, SAP_PASSWORD, SAP_COMPANY_DB,
#   HMAC_SECRET, JWT_SECRET_KEY, CORS_ORIGIN
# =============================================================================

DOCKER_REGISTRY=ayushaher118
TAG=staging

# Separate Postgres database on the same server as UAT (do not reuse Database=SapApi).
DB_CONNECTION=Host=postgres;Port=5432;Database=SapApi_Staging;Username=postgres;Password=CHANGE_ME;Pooling=true;MinPoolSize=5;MaxPoolSize=100;ConnectionIdleLifetime=300;ConnectionPruningInterval=10

REDIS_CONNECTION=redis:6379,abortConnect=false

SAP_SERVICE_LAYER_URL=https://192.168.0.6:50000
SAP_USERNAME=manager
SAP_PASSWORD=CHANGE_ME_manager_sap_password
SAP_COMPANY_DB=PBBPL_UAT

HMAC_SECRET=CHANGE_ME_staging_hmac_secret_openssl_rand_hex_32
JWT_SECRET_KEY=CHANGE_ME_staging_jwt_openssl_rand_base64_32
# Must match UAT AES_KEY_BASE64 so cloned ApprovalRequests.RequestBody ciphertext decrypts.
AES_KEY_BASE64=

CORS_ORIGIN=http://192.168.0.5:8083

# Outgoing email — Microsoft Graph app-only auth (client-credentials), sending as
# no-reply@connect-edge.privilegeboilers.com. Replaces SMTP AUTH, which Microsoft 365 disabled for
# this tenant. Create an Entra ID app registration with the Mail.Send application permission
# (admin consent required), then set these from that registration's Overview + Certificates & secrets.
GRAPH_TENANT_ID=CHANGE_ME_entra_tenant_id
GRAPH_CLIENT_ID=CHANGE_ME_entra_app_client_id
GRAPH_CLIENT_SECRET=CHANGE_ME_entra_app_client_secret
GRAPH_SENDER_MAILBOX=no-reply@connect-edge.privilegeboilers.com
